# Normalize line endings to LF on commit
* text=auto eol=lf

# Force LF for these file types
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.env.example text eol=lf

# Binaries
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
