# CiberCortex IA — Environment Variables Example
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# --- Application ---
APP_NAME=CiberCortexIA
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cibercortex:password@localhost:5432/cibercortex_db

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ---
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Anthropic / AI ---
ANTHROPIC_API_KEY=sk-ant-...
AI_MAX_CALLS_PER_MINUTE=10
AI_MODEL=claude-sonnet-4-6

# --- NVD API ---
NVD_API_KEY=                 # Optional but recommended (higher rate limit)
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# --- Scanning ---
NMAP_PATH=/usr/bin/nmap
SCAN_MAX_CONCURRENT=3        # Max parallel scan jobs
SCAN_DEFAULT_TIMEOUT=300     # seconds

# --- Reporting ---
REPORTS_STORAGE_PATH=/app/reports
REPORTS_MAX_SIZE_MB=50

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
