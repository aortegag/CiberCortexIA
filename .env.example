# CiberCortex IA — Variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA commits el archivo .env al repositorio.
#
# Generación rápida de claves seguras:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME=CiberCortex IA
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ── Base de datos (PostgreSQL) ────────────────────────────────────────────────
# Usadas por docker compose para crear el contenedor de Postgres
# y por config.py para construir DATABASE_URL
DB_USER=cybercortex
DB_PASSWORD=cybercortex-dev-password
DB_HOST=localhost                # En Docker: 'db' (nombre del servicio)
DB_PORT=5432
DB_NAME=cybercortex

# Puerto expuesto del contenedor Postgres (útil para evitar conflictos)
DB_EXPOSE_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_EXPOSE_PORT=6379

# ── Auth JWT ──────────────────────────────────────────────────────────────────
# ⚠️  CAMBIAR en producción — mínimo 32 caracteres
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Anthropic / AI Assist Lite ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_RATE_LIMIT_PER_USER_PER_HOUR=5
AI_CACHE_TTL_SECONDS=86400

# ── NVD API (correlación CVE) ─────────────────────────────────────────────────
# Sin clave: 5 req/30s  |  Con clave: 50 req/30s
# Regístrate gratis: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_RATE_LIMIT_RPM=5
NVD_CACHE_TTL_SECONDS=86400

# ── Escaneos (nmap) ────────────────────────────────────────────────────────────
NMAP_SCAN_TIMEOUT_SECONDS=300

# ── Reportes PDF ──────────────────────────────────────────────────────────────
REPORTS_DIR=/tmp/cybercortex/reports

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista separada por comas
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# NEXT_PUBLIC_* son visibles en el navegador
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Seed (usuario admin inicial) ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@cibercortex.local
SEED_ADMIN_PASSWORD=CiberCortex2024!
SEED_ADMIN_NAME=Admin CiberCortex

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
